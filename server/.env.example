# CiteCheck AI — Server Configuration

# Express Port
PORT=5001

# MongoDB Atlas Database URI (Required for persistent storage across deployments)
# Example Atlas format: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/citecheck?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/citecheck

# bcrypt rounds (default: 10 locally, set to 8 on Render free tier for faster hashing)
# BCRYPT_ROUNDS=8

# Google Gemini API Key (Get yours at https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Recommended Gemini Model (e.g. gemini-2.5-flash or gemini-1.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# Frontend application URL for email verification links
APP_URL=http://localhost:5173

# Email Service (Nodemailer SMTP Configuration)
# When configured, verification emails are sent via SMTP.
# If left empty, verification links are safely logged in the server console for local testing.

EMAIL_HOST=
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_FROM="CiteCheck AI" <noreply@citecheck.ai>