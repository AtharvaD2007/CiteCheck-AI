{
  "name": "citecheck-ai-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "AI-powered Academic Citation Verification System",
  "scripts": {
    "server": "node --watch server/src/index.js",
    "client": "npm --prefix client run dev",
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"blue,cyan\" \"npm run server\" \"npm run client\"",
    "build": "npm --prefix client run build",
    "install:all": "npm install && npm --prefix server install && npm --prefix client install"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
